# development | test | production. Production refuses to start with a weak JWT_SECRET or
# (with LLM_PROVIDER=anthropic) no ANTHROPIC_API_KEY, hides /docs, and sends HSTS.
ENVIRONMENT=development
# Demo deployments only: enables /ingest/phmsa-sync sample data, seed_demo.py, and the
# demo accounts' MFA bypass. Never enable for a real customer.
DEMO_MODE=false

DATABASE_URL=postgresql+asyncpg://pipelinegpt:pipelinegpt@localhost:5432/pipelinegpt
REDIS_URL=redis://localhost:6379/0
# AI provider: anthropic | bedrock | vertex. Check it with: python check_llm.py
LLM_PROVIDER=anthropic
# anthropic/vertex: claude-sonnet-4-6    bedrock: anthropic.claude-sonnet-5 (Bedrock has no Sonnet 4.6)
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...
# bedrock: region + the standard AWS credential chain (AWS_PROFILE, AWS_ACCESS_KEY_ID/..., IAM role)
# AWS_REGION=us-east-1
# vertex: project + Application Default Credentials (gcloud auth application-default login,
# or GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json)
# VERTEX_PROJECT_ID=my-gcp-project
# VERTEX_REGION=global

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
MFA_PENDING_TOKEN_EXPIRE_MINUTES=15

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Failed sign-ins allowed per email (per IP: 4x) before a lockout of LOGIN_LOCKOUT_SECONDS
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

MAX_TOKENS_PER_DAY=100000
UPLOAD_MAX_BYTES=52428800
# Uploads wait here for the worker when running uvicorn/celery directly; both must share it.
# docker-compose.yml overrides it with the shared volume /data/uploads.
UPLOAD_DIR=data/uploads
# OCR of scanned PDF pages needs the tesseract binary (bundled in the Docker image).
OCR_ENABLED=true
OCR_LANGUAGES=eng
HITL_CONFIDENCE_THRESHOLD=0.75
TOP_K_RETRIEVAL=12
TOP_K_RERANK=6
SEMANTIC_CACHE_SIMILARITY=0.97
SEMANTIC_CACHE_TTL_SECONDS=86400
