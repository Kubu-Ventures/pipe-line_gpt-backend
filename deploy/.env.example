# PipelineGPT deployment settings. ./install.sh fills this in for you.
# Keep this file private (chmod 600): it holds every secret for the stack.

# Public hostname users open in the browser. DNS must point here before first start.
PIPELINEGPT_DOMAIN=pipelinegpt.example.com
# Email for the Let's Encrypt account (certificate expiry notices).
ACME_EMAIL=ops@example.com
# Image version to run (a release tag, e.g. 0.2.0). Change it to upgrade: ./upgrade.sh 0.3.0
PIPELINEGPT_VERSION=0.2.0

# AI provider: anthropic | bedrock | vertex. With bedrock or vertex, questions and
# document excerpts are processed by your own AWS / Google Cloud account.
LLM_PROVIDER=anthropic
# Model ID format depends on the provider:
#   anthropic, vertex: claude-sonnet-4-6        bedrock: anthropic.claude-sonnet-5
# (Bedrock offers Sonnet 5 and newer, not Sonnet 4.6.)
LLM_MODEL=claude-sonnet-4-6
# anthropic only
ANTHROPIC_API_KEY=
# bedrock only. Leave the keys empty to use the server's IAM role instead.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# vertex only. Put the service-account key at secrets/gcp-key.json and enable the mount:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.vertex.yml
VERTEX_PROJECT_ID=
# global routes across regions; set a region (e.g. europe-west4) for data residency.
VERTEX_REGION=global

# Generate each with: openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
JWT_SECRET=
NEXTAUTH_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Optional tuning
DEMO_MODE=false
WEB_CONCURRENCY=2
WORKER_CONCURRENCY=2
MAX_TOKENS_PER_DAY=100000
UPLOAD_MAX_BYTES=52428800
# Scanned PDF pages are OCR'd. Languages: eng ara chi_sim deu fra hin jpn por rus spa, joined with +.
OCR_ENABLED=true
OCR_LANGUAGES=eng
HITL_CONFIDENCE_THRESHOLD=0.75
